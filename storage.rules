rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isImageUpload() {
      return request.resource != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /projects/{projectId}/photos/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageUpload();
    }

    match /leads/{leadId}/{fileName} {
      allow read: if true;
      allow write: if isImageUpload();
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
